# Core EventLoop Engine
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./timer.alya"
import "./watcher.alya"
import "./poller.alya"

# Creates a new initialized EventLoop instance
pub function event_loop_new()
    return EventLoop {
        running: 0,
        timers: [],
        watchers: [],
        next_timer_id: 1,
        next_watcher_id: 1,
        tick_count: 0,
        stop_requested: 0
    }
end

# Requests the event loop to stop
pub function loop_stop(loop)
    if loop is not null
        loop.stop_requested = 1
        loop.running = 0
    end
end

# Returns 1 if the event loop is active and has work to do, 0 otherwise
pub function loop_is_running(loop)
    if loop is null or loop.stop_requested == 1
        return 0
    end
    let timers = timer_count_active(loop)
    let watchers = watcher_count_active(loop)
    if (timers + watchers) > 0
        return 1
    end
    return 0
end

# Returns the total count of active handles (timers + I/O watchers)
pub function loop_active_count(loop)
    if loop is null
        return 0
    end
    let t = timer_count_active(loop)
    let w = watcher_count_active(loop)
    return t + w
end

# Resets all state in the loop
pub function loop_reset(loop)
    if loop is not null
        loop.timers = []
        loop.watchers = []
        loop.stop_requested = 0
        loop.running = 0
        loop.tick_count = 0
    end
end

# Executes a single tick through the event loop phases:
# 1. Calculate dynamic timeout based on closest timer
# 2. Poll socket I/O watchers
# 3. Collect expired timers
# Returns an array of EventNotification records triggered in this tick
pub function loop_tick(loop, max_wait_ms = 100)
    if loop is null
        return []
    end
    if max_wait_ms is null or max_wait_ms < 0
        max_wait_ms = 0
    end

    loop.running = 1
    loop.tick_count += 1

    # 1. Dynamic sleep limit: do not sleep longer than the next pending timer
    let wait_ms = timer_nearest_wait_ms(loop, max_wait_ms)

    # 2. I/O Polling Phase
    let io_events = poller_poll_watchers(loop, wait_ms)

    # 3. Timers Phase
    let timer_events = timer_collect_expired(loop)

    # 4. Merge notifications
    let all_events = []
    for ev in io_events
        push(all_events, ev)
    end
    for ev in timer_events
        push(all_events, ev)
    end

    return all_events
end

# Polls the event loop for up to max_wait_ms milliseconds and returns all triggered events
pub function loop_poll(loop, max_wait_ms = 100)
    return loop_tick(loop, max_wait_ms)
end

# --- Struct Methods on EventLoop ---

pub function EventLoop.stop(self)
    loop_stop(self)
end

pub function EventLoop.is_running(self)
    return loop_is_running(self)
end

pub function EventLoop.active_count(self)
    return loop_active_count(self)
end

pub function EventLoop.reset(self)
    loop_reset(self)
end

pub function EventLoop.tick(self, max_wait_ms = 100)
    return loop_tick(self, max_wait_ms)
end

pub function EventLoop.poll(self, max_wait_ms = 100)
    return loop_poll(self, max_wait_ms)
end

pub function EventLoop.timeout(self, delay_ms, tag = "", data = null)
    return timer_add_timeout(self, delay_ms, tag, data)
end

pub function EventLoop.interval(self, interval_ms, tag = "", data = null)
    return timer_add_interval(self, interval_ms, tag, data)
end

pub function EventLoop.clear_timer(self, timer_id)
    return timer_cancel(self, timer_id)
end

pub function EventLoop.watch_read(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 1, tag, data)
end

pub function EventLoop.watch_write(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 2, tag, data)
end

pub function EventLoop.unwatch(self, fd)
    return watcher_remove(self, fd)
end
