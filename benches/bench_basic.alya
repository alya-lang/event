## Benchmark suite for the event package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "std/net"
import "../src/lib.alya" as ev

function main()
    let runner = bench_runner("event Engine Micro-Benchmarks")

    # 1. EventLoop Tick Throughput (zero-wait ticks)
    let loop1 = ev::loop()
    bench_start(runner, 20000)
    let i = 0
    while i < 20000
        ev::loop_tick(loop1, 0)
        i += 1
    end
    bench_stop(runner, "loop_tick() empty tick throughput (20,000 ticks)")

    # 2. Timer Scheduling & Cancellation Throughput
    let loop2 = ev::loop()
    bench_start(runner, 10000)
    let j = 0
    while j < 10000
        let tid = ev::set_timeout(loop2, 1000, "bench_timer", null)
        ev::clear_timer(loop2, tid)
        j += 1
    end
    bench_stop(runner, "set_timeout() + clear_timer() (10,000 pairs)")

    # 3. Stream ByteBuffer Assembly & Extraction
    let buf = ev::buffer()
    bench_start(runner, 15000)
    let k = 0
    while k < 15000
        ev::buffer_append(buf, "POST /api/v1/telemetry HTTP/1.1\r\nContent-Length: 42\r\n\r\n")
        ev::buffer_read_line(buf)
        ev::buffer_read_line(buf)
        ev::buffer_clear(buf)
        k += 1
    end
    bench_stop(runner, "ByteBuffer append + read_line x2 + clear (15,000 ops)")

    # 4. EventEmitter Dispatch Throughput
    let em = ev::emitter()
    ev::emitter_on(em, "telemetry_ping", "logger_1")
    ev::emitter_on(em, "telemetry_ping", "logger_2")
    bench_start(runner, 20000)
    let m = 0
    while m < 20000
        ev::emitter_emit(em, "telemetry_ping", null)
        m += 1
    end
    bench_stop(runner, "EventEmitter 2-listener dispatch (20,000 emits)")

    # 5. Kernel Multiplexer Zero-Wait Polling Throughput
    let loop3 = ev::loop()
    let s_bench = tcp_listen(19899, 10)
    tcp_set_nonblocking(s_bench, 1)
    loop3.watch_readable(s_bench, "bench_srv", null)
    bench_start(runner, 20000)
    let n = 0
    while n < 20000
        loop3.poll(0)
        n += 1
    end
    bench_stop(runner, "Kernel Multiplexer loop.poll(0) (20,000 polls)")
    loop3.unwatch(s_bench)
    tcp_close(s_bench)
    loop3.free()

    # 6. StreamReader Line Framing & Packet Assembly
    let rdr = ev::reader("\n")
    bench_start(runner, 20000)
    let p = 0
    while p < 20000
        rdr.feed("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n")
        rdr.read_line()
        rdr.read_line()
        p += 1
    end
    bench_stop(runner, "StreamReader feed + read_line x2 (20,000 ops)")

    # 7. RingBuffer High-Speed Churn
    let rng = ev::ring(1024)
    bench_start(runner, 25000)
    let q = 0
    while q < 25000
        rng.write("PING_PAYLOAD_CHUNK_1234567890")
        rng.read(30)
        q += 1
    end
    bench_stop(runner, "RingBuffer write + read throughput (25,000 ops)")

    bench_summary(runner)
end

main()
