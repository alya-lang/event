# event - High-Concurrency Reactor Event Loop, Timers, and I/O Multiplexer
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "uv" as uv
import "./types.alya"
import "./core/loop.alya"
import "./core/timer.alya"
import "./core/watcher.alya"
import "./core/poller.alya"
import "./emitter/emitter.alya"
import "./stream/buffer.alya"
import "./stream/ring.alya"
import "./stream/reader.alya"
import "./stream/stream.alya"
import "./net/server.alya"
import "./net/client.alya"

# --- Convenience Aliases ---

# Factory alias for EventLoop
pub function loop(use_uv = true)
    return event_loop_new(use_uv)
end

pub function loop_new(use_uv = true)
    return event_loop_new(use_uv)
end

# Factory alias for EventEmitter
pub function emitter()
    return event_emitter_new()
end

# Factory alias for ByteBuffer
pub function buffer()
    return byte_buffer_new()
end

# Convenience alias for querying loop active backend
pub function backend(loop)
    return loop_backend(loop)
end

# Convenience alias for adding a timeout
pub function set_timeout(loop, delay_ms, tag = "", data = null)
    return timer_add_timeout(loop, delay_ms, tag, data)
end

# Convenience alias for adding an interval
pub function set_interval(loop, interval_ms, tag = "", data = null)
    return timer_add_interval(loop, interval_ms, tag, data)
end

# Convenience alias for clearing a timer
pub function clear_timer(loop, timer_id)
    return timer_cancel(loop, timer_id)
end

# Convenience alias for watching a socket for readable incoming data
pub function watch_read(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 1, tag, data)
end

# Convenience alias for watching a socket for writable readiness
pub function watch_write(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 2, tag, data)
end

# Convenience alias for unwatching a socket
pub function unwatch(loop, fd)
    return watcher_remove(loop, fd)
end

# Convenience alias matching Phase 1 spec for readable watch
pub function watch_readable(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 1, tag, data)
end

# Convenience alias matching Phase 1 spec for writable watch
pub function watch_writable(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 2, tag, data)
end

# Convenience alias for watching an OS process signal
pub function watch_signal(loop, signum, tag = "signal", data = null)
    return loop_watch_signal(loop, signum, tag, data)
end

# Convenience alias for unwatching an OS process signal
pub function unwatch_signal(loop, signum)
    return loop_unwatch_signal(loop, signum)
end

# Factory alias for RingBuffer
pub function ring(capacity = 65536)
    return ring_buffer_new(capacity)
end

# Factory alias for StreamReader
pub function reader(delimiter = "\n", max_frame_size = 1048576, capacity = 65536)
    return stream_reader_new(delimiter, max_frame_size, capacity)
end

# Factory alias for TcpStream
pub function stream(loop, fd, high_water_mark = 65536)
    return tcp_stream_new(loop, fd, high_water_mark)
end

# Factory alias for TcpServer
pub function server(loop, host, port, on_connect, on_error = null, backlog = 128)
    return tcp_server_listen(loop, host, port, on_connect, on_error, backlog)
end

# Factory alias for TcpClient
pub function client(loop, host, port, on_connect = null, on_error = null)
    return tcp_client_connect(loop, host, port, on_connect, on_error)
end

# Convenience dispatcher for event notifications
pub function dispatch(ev)
    return loop_dispatch_event(ev)
end
