# Cross-Platform Socket Poller & Kernel Multiplexer
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net" as net
import "../types.alya"
import "./watcher.alya"

# Polls all registered active watchers for readiness within the allocated timeout
# Returns an array of EventNotification structs
pub function poller_poll_watchers(loop, wait_ms = 0)
    if loop is null
        return []
    end
    let events = []
    let w_count = len(loop.watchers)
    if w_count == 0
        if wait_ms > 0
            sleep(wait_ms)
        end
        return events
    end

    # Fast path: Native OS Kernel Multiplexer (epoll / WSAPoll / kqueue via Lib/uv)
    if loop.poller is not null
        let uv_events = loop.poller.wait(wait_ms)
        if len(uv_events) == 0
            return events
        end
        for ev in uv_events
            let w: IoWatcher = watcher_find(loop, ev.fd)
            if w is null
                w = watcher_find_by_id(loop, ev.udata)
            end
            if w is null
                continue
            end
            let real_fd = w.fd
            let tag = w.tag
            let data = w.data

            # Map uv kernel events back to EventNotification matching watcher interest
            if (w.events & 1) != 0 and (ev.events & 1) != 0 # Readable
                push(events, event_notification_new(EventType.Read, real_fd, -1, tag, data))
            end
            if (w.events & 2) != 0 and (ev.events & 2) != 0 # Writable
                push(events, event_notification_new(EventType.Write, real_fd, -1, tag, data))
            end
            if (ev.events & 4) != 0 or (ev.events & 8) != 0 # Error or Hangup
                push(events, event_notification_new(EventType.Error, real_fd, -1, tag, data))
            end
            if (ev.events & 16) != 0 # Signal
                push(events, event_notification_new(EventType.Signal, real_fd, -1, tag, data))
            end
        end
        return events
    end

    # Fallback path: Pure std/net linear polling loop
    # Fast path: single watcher can use the full wait duration directly
    if w_count == 1
        let w = loop.watchers[0]
        if w.active == 1
            let res = net::tcp_poll(w.fd, wait_ms)
            when res
                is 1 then
                    push(events, event_notification_new(EventType.Read, w.fd, -1, w.tag, w.data))
                is -1 then
                    push(events, event_notification_new(EventType.Error, w.fd, -1, w.tag, w.data))
            end
        end
        return events
    end

    # Multi-watcher path:
    # 1. Non-blocking probe first (timeout = 0)
    for w in loop.watchers
        if w.active == 1
            let res = net::tcp_poll(w.fd, 0)
            when res
                is 1 then
                    push(events, event_notification_new(EventType.Read, w.fd, -1, w.tag, w.data))
                is -1 then
                    push(events, event_notification_new(EventType.Error, w.fd, -1, w.tag, w.data))
            end
        end
    end

    # If events were found or zero wait was requested, return immediately
    if len(events) > 0 or wait_ms <= 0
        return events
    end

    # 2. If nothing ready, poll in small discrete slices until timeout expires
    let start = clock_ms()
    while (clock_ms() - start) < wait_ms
        sleep(2)
        for w in loop.watchers
            if w.active == 1
                let res = net::tcp_poll(w.fd, 0)
                when res
                    is 1 then
                        push(events, event_notification_new(EventType.Read, w.fd, -1, w.tag, w.data))
                    is -1 then
                        push(events, event_notification_new(EventType.Error, w.fd, -1, w.tag, w.data))
                end
            end
        end
        if len(events) > 0
            break
        end
    end

    return events
end
