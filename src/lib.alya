## # event
##
## High-concurrency reactor event loop, timers, streams, and I/O multiplexer for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Provides cooperative single-threaded asynchronous I/O, timers, socket streams,
## TCP servers and clients, buffered stream readers, event emitters, and async filesystem operations.

import "./types.alya"
import "./core/loop.alya"
import "./core/timer.alya"
import "./core/watcher.alya"
import "./core/poller.alya"
import "./emitter/emitter.alya"
import "./stream/buffer.alya"
import "./stream/ring.alya"
import "./stream/reader.alya"
import "./stream/stream.alya"
import "./net/server.alya"
import "./net/client.alya"
import "./fs/async.alya"

# ═══════════════════════════════════════════════════════════════
# EventLoop Factory & Control
# ═══════════════════════════════════════════════════════════════

## Creates a new EventLoop instance.
##
## ### Parameters
## - `use_uv`: `true` to enable native OS kernel multiplexer (Lib/uv), `false` for fallback.
##
## ### Returns
## Initialized `EventLoop` instance.
pub function loop(use_uv = true)
    return event_loop_new(use_uv)
end

## Creates a new EventLoop instance (alias for `loop`).
pub function loop_new(use_uv = true)
    return event_loop_new(use_uv)
end

## Returns the active kernel backend name ("WSAPoll", "epoll", "kqueue", or "fallback").
pub function backend(loop)
    return loop_backend(loop)
end

## Polls registered active socket watchers for I/O readiness within wait_ms.
pub function poll(loop, wait_ms = 0)
    return poller_poll_watchers(loop, wait_ms)
end

# ═══════════════════════════════════════════════════════════════
# Timer Operations
# ═══════════════════════════════════════════════════════════════

## Registers a one-shot timeout timer.
##
## ### Parameters
## - `loop`: Target `EventLoop`.
## - `delay_ms`: Delay duration in milliseconds.
## - `tag`: Optional tag identifier.
## - `data`: Optional attached payload or callback.
##
## ### Returns
## Integer timer identifier.
pub function set_timeout(loop, delay_ms, tag = "", data = null)
    return timer_add_timeout(loop, delay_ms, tag, data)
end

## Registers a periodic interval timer.
##
## ### Parameters
## - `loop`: Target `EventLoop`.
## - `interval_ms`: Periodic duration in milliseconds.
## - `tag`: Optional tag identifier.
## - `data`: Optional attached payload or callback.
##
## ### Returns
## Integer timer identifier.
pub function set_interval(loop, interval_ms, tag = "", data = null)
    return timer_add_interval(loop, interval_ms, tag, data)
end

## Cancels an active timer by its identifier.
pub function clear_timer(loop, timer_id)
    return timer_cancel(loop, timer_id)
end

# ═══════════════════════════════════════════════════════════════
# Socket Watcher Operations
# ═══════════════════════════════════════════════════════════════

## Registers socket descriptor for readable incoming data events.
pub function watch_read(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 1, tag, data)
end

## Registers socket descriptor for writable readiness events.
pub function watch_write(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 2, tag, data)
end

## Deregisters an active socket watcher.
pub function unwatch(loop, fd)
    return watcher_remove(loop, fd)
end

## Alias for `watch_read`.
pub function watch_readable(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 1, tag, data)
end

## Alias for `watch_write`.
pub function watch_writable(loop, fd, tag = "", data = null)
    return watcher_add(loop, fd, 2, tag, data)
end

## Registers an OS process signal watcher.
pub function watch_signal(loop, signum, tag = "signal", data = null)
    return loop_watch_signal(loop, signum, tag, data)
end

## Deregisters an OS process signal watcher.
pub function unwatch_signal(loop, signum)
    return loop_unwatch_signal(loop, signum)
end

# ═══════════════════════════════════════════════════════════════
# Buffers, Streams & Networking
# ═══════════════════════════════════════════════════════════════

## Creates an empty StreamBuffer.
pub function buffer()
    return byte_buffer_new()
end

## Creates a new EventEmitter instance.
pub function emitter()
    return event_emitter_new()
end

## Creates a new circular RingBuffer instance.
pub function ring(capacity = 65536)
    return ring_buffer_new(capacity)
end

## Creates a frame-delimited StreamReader wrapping a stream ring buffer.
pub function reader(delimiter = "\n", max_frame_size = 1048576, capacity = 65536)
    return stream_reader_new(delimiter, max_frame_size, capacity)
end

## Creates a high-level non-blocking TcpStream wrapping a socket handle.
pub function stream(loop, fd, high_water_mark = 65536)
    return tcp_stream_new(loop, fd, high_water_mark)
end

## Starts listening on host:port and dispatches incoming TCP connections.
pub function server(loop, host, port, on_connect, on_error = null, backlog = 128)
    return tcp_server_listen(loop, host, port, on_connect, on_error, backlog)
end

## Connects asynchronously to a remote TCP host:port.
pub function client(loop, host, port, on_connect = null, on_error = null)
    return tcp_client_connect(loop, host, port, on_connect, on_error)
end

## Dispatches an event notification to its registered handler.
pub function dispatch(ev)
    return loop_dispatch_event(ev)
end

# ═══════════════════════════════════════════════════════════════
# Asynchronous Filesystem Operations
# ═══════════════════════════════════════════════════════════════

## Reads a file asynchronously off the main reactor loop.
pub function read_async(loop, path, on_complete)
    return fs_read_async(loop, path, on_complete)
end

## Writes data to a file asynchronously off the main reactor loop.
pub function write_async(loop, path, data, on_complete = null)
    return fs_write_async(loop, path, data, on_complete)
end

## Alias for `read_async`.
pub function read_file_async(loop, path, on_complete)
    return fs_read_async(loop, path, on_complete)
end

## Alias for `write_async`.
pub function write_file_async(loop, path, data, on_complete = null)
    return fs_write_async(loop, path, data, on_complete)
end
