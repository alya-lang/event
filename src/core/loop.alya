# Core EventLoop Engine
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "./timer.alya"
import "./watcher.alya"
import "./poller.alya"

# Creates a new initialized EventLoop instance
function event_loop_new()
    return EventLoop {
        running: 0,
        timers: [],
        watchers: [],
        next_timer_id: 1,
        next_watcher_id: 1,
        tick_count: 0,
        stop_requested: 0,
        time_ms: clock_ms()
    }
end

# Returns the current monotonic time in milliseconds tracked by the loop
function loop_now(loop)
    if loop == null
        return clock_ms()
    end
    let c = clock_ms()
    if c > loop.time_ms
        loop.time_ms = c
    end
    return loop.time_ms
end

# Requests the event loop to stop
function loop_stop(loop)
    if loop != null
        loop.stop_requested = 1
        loop.running = 0
    end
end

# Returns 1 if the event loop is active and has work to do, 0 otherwise
function loop_is_running(loop)
    if loop == null or loop.stop_requested == 1
        return 0
    end
    let timers = timer_count_active(loop)
    let watchers = watcher_count_active(loop)
    if (timers + watchers) > 0
        return 1
    end
    return 0
end

# Returns the total count of active handles (timers + I/O watchers)
function loop_active_count(loop)
    if loop == null
        return 0
    end
    let t = timer_count_active(loop)
    let w = watcher_count_active(loop)
    return t + w
end

# Resets all state in the loop
function loop_reset(loop)
    if loop != null
        loop.timers = []
        loop.watchers = []
        loop.stop_requested = 0
        loop.running = 0
        loop.tick_count = 0
        loop.time_ms = clock_ms()
    end
end

# Executes a single tick through the event loop phases:
# 1. Calculate dynamic timeout based on closest timer
# 2. Poll socket I/O watchers
# 3. Collect expired timers
# Returns an array of EventNotification records triggered in this tick
function loop_tick(loop, max_wait_ms = 100)
    if loop == null
        return []
    end
    if max_wait_ms == null or max_wait_ms < 0
        max_wait_ms = 0
    end

    loop.running = 1
    loop.tick_count += 1

    # 1. Dynamic sleep limit: do not sleep longer than the next pending timer
    let wait_ms = timer_nearest_wait_ms(loop, max_wait_ms)

    # 2. I/O Polling Phase
    let io_events = poller_poll_watchers(loop, wait_ms)

    # 3. Advance loop clock by the elapsed sleep duration
    if wait_ms > 0
        loop.time_ms += wait_ms
    end
    let _ = loop_now(loop)

    # 4. Timers Phase
    let timer_events = timer_collect_expired(loop)

    # 4. Merge notifications
    let all_events = []
    let i = 0
    let io_len = len(io_events)
    while i < io_len
        push(all_events, io_events[i])
        i += 1
    end

    let j = 0
    let timer_len = len(timer_events)
    while j < timer_len
        push(all_events, timer_events[j])
        j += 1
    end

    return all_events
end

# Polls the event loop for up to max_wait_ms milliseconds and returns all triggered events
function loop_poll(loop, max_wait_ms = 100)
    return loop_tick(loop, max_wait_ms)
end
