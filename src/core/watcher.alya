# Socket I/O Watcher Registry for EventLoop
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"

# Registers an I/O watcher for socket `fd`
# `events`: 1 (READ), 2 (WRITE), or 3 (READ | WRITE)
pub function watcher_add(loop, fd, events = 1, tag = "", data = null)
    if loop is null or fd is null or fd < 0
        return -1
    end
    # Check if an existing watcher for this fd is already registered
    for w in loop.watchers
        if w.fd == fd and w.active == 1
            # Update existing watcher with new events / tag / data
            w.events = events
            w.tag = tag
            w.data = data
            if loop.poller is not null
                loop.poller.modify(fd, events, w.id)
            end
            return w.id
        end
    end

    let wid = loop.next_watcher_id
    loop.next_watcher_id += 1
    let w = io_watcher_new(wid, fd, events, tag, data)
    push(loop.watchers, w)
    if loop.poller is not null
        loop.poller.add(fd, events, wid)
    end
    return wid
end

# Removes an I/O watcher for a socket descriptor
# Returns 1 if found and removed, 0 otherwise
pub function watcher_remove(loop, fd)
    if loop is null or fd is null
        return 0
    end
    let removed = 0
    let active_remaining = []
    for w in loop.watchers
        if w.fd == fd
            w.active = 0
            removed = 1
        else
            if w.active == 1
                push(active_remaining, w)
            end
        end
    end
    loop.watchers = active_remaining
    if removed == 1 and loop.poller is not null
        loop.poller.remove(fd)
    end
    return removed
end

# Returns the number of currently active socket watchers
pub function watcher_count_active(loop)
    if loop is null
        return 0
    end
    let active_count = 0
    for w in loop.watchers
        if w.active == 1
            active_count += 1
        end
    end
    return active_count
end

# Finds an active watcher by socket descriptor
pub function watcher_find(loop, fd) -> IoWatcher
    if loop is null or fd is null
        return null
    end
    for w in loop.watchers
        if w.fd == fd and w.active == 1
            return w
        end
    end
    return null
end

# Finds an active watcher by unique watcher ID
pub function watcher_find_by_id(loop, wid) -> IoWatcher
    if loop is null or wid is null
        return null
    end
    for w in loop.watchers
        if w.id == wid and w.active == 1
            return w
        end
    end
    return null
end
