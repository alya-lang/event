## Test suite for TcpStream Flow Control, Backpressure, and Framing
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "std/net"
import "../src/lib.alya" as ev

struct LineStore
    lines
end

function handle_server_line(stream, line)
    let s = stream.data
    push(s.lines, line)
end

function main()
    test_suite("event Package TcpStream & Flow Control Test Suite")
    let r = runner_new()

    let l = ev::loop()
    let port = 19991

    # Setup server socket
    let srv = tcp_listen(port, 5)
    runner_assert(r, srv >= 0, "server listening")
    if srv < 0
        runner_summary(r)
        return
    end
    tcp_set_nonblocking(srv, true)

    # Connect client (blocking: throws SocketError on failure)
    let client_raw = tcp_connect("127.0.0.1", port)

    # Accept may race the connect on loaded runners (nonblocking
    # accept returns -1 with nothing pending yet): retry briefly
    # instead of cascading a -1 fd into a null stream below, which
    # segfaults silently on field access.
    let accepted_raw = -1
    let accept_ticks = 0
    while accepted_raw < 0 and accept_ticks < 1000
        accepted_raw = tcp_accept(srv)
        accept_ticks += 1
    end

    runner_assert(r, client_raw >= 0, "client socket created")
    runner_assert(r, accepted_raw >= 0, "server accepted connection")
    if accepted_raw < 0
        tcp_close(srv)
        runner_summary(r)
        return
    end

    # Wrap both into TcpStream
    let client_stream = ev::stream(l, client_raw, 64) # 64 bytes high water mark
    let server_stream = ev::stream(l, accepted_raw, 64)

    runner_assert_eq(r, client_stream.is_closed(), false, "client stream should be open")
    runner_assert_eq(r, server_stream.is_closed(), false, "server stream should be open")
    runner_assert_eq(r, client_stream.is_paused(), false, "client stream should not be paused")

    # 1. Flow Control: pause and resume
    let p_res = client_stream.pause()
    runner_assert_eq(r, p_res, true, "pause returned 1")
    runner_assert_eq(r, client_stream.is_paused(), true, "client stream is paused")

    let r_res = client_stream.resume()
    runner_assert_eq(r, r_res, true, "resume returned 1")
    runner_assert_eq(r, client_stream.is_paused(), false, "client stream is unpaused")

    # 2. Non-blocking write & Line framing over TcpStream
    let store = LineStore { lines: [] }
    server_stream.data = store
    server_stream.on_line(handle_server_line)

    # Write multiple lines from client to server
    client_stream.write("MessageOne\r\nMessageTwo\n")

    # Run loop tick to process network transmission
    let ticks = 0
    while len(store.lines) < 2 and ticks < 10
        let events = l.tick(10)
        for ev in events
            l.dispatch(ev)
        end
        ticks += 1
    end

    runner_assert_eq(r, len(store.lines), 2, "server received 2 framed lines")
    if len(store.lines) >= 2
        runner_assert_str_eq(r, store.lines[0], "MessageOne", "line 1 match")
        runner_assert_str_eq(r, store.lines[1], "MessageTwo", "line 2 match")
    end

    # 3. Backpressure detection
    # High water mark is 64 bytes. If buffer exceeds, write returns 0
    let big_payload = "1234567890123456789012345678901234567890123456789012345678901234567890" # 70 bytes
    client_stream.write_buf.append(big_payload) # manually force write buffer to exceed high water mark
    let bp_write = client_stream.write("extra")
    runner_assert_eq(r, bp_write, 0, "write returns 0 when high water mark is reached")

    # Drain buffer
    client_stream.write_buf.clear()
    runner_assert_eq(r, client_stream.buffered_bytes(), 0, "buffer cleared to 0")

    # 4. Stream Close Lifecycle
    client_stream.close()
    server_stream.close()
    tcp_close(srv)

    runner_assert_eq(r, client_stream.is_closed(), true, "client stream closed")
    runner_assert_eq(r, server_stream.is_closed(), true, "server stream closed")

    runner_summary(r)
end

main()
