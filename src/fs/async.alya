## # event/fs/async
##
## Asynchronous offloaded file system and worker thread pool for EventLoop.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/sync"
import "../types.alya"

## Represents a single queued or in-flight async filesystem task.
pub struct FsTask
    id,
    op,
    path,
    tag,
    data,
    on_complete,
    result_data,
    result_error,
    bytes_processed,
    success
end

## Constructs an FsTask instance
pub function fs_task_new(id, op: string, path: string, data = null, on_complete = null)
    return FsTask {
        id: id,
        op: op,
        path: path,
        tag: "fs_async",
        data: data,
        on_complete: on_complete,
        result_data: null,
        result_error: null,
        bytes_processed: 0,
        success: 0
    }
end

# Background worker routine that continuously pulls filesystem tasks from req_ch
# and posts completed tasks into res_ch
function fs_worker_proc(channels)
    let req_ch = channels[0]
    let res_ch = channels[1]
    while 1
        let task = channel_recv(req_ch, 500)
        if task is not null
            if task.op == "stop"
                break
            end
            if task.op == "read"
                if file_exists(task.path) == 0
                    task.success = 0
                    task.result_error = "File not found: " + task.path
                    task.result_data = ""
                    task.bytes_processed = 0
                else
                    try
                        let content = read_file(task.path)
                        task.result_data = content
                        task.bytes_processed = len(content)
                        task.success = 1
                        task.result_error = null
                    catch err
                        task.success = 0
                        task.result_error = str(err)
                        task.result_data = ""
                        task.bytes_processed = 0
                    end
                end
            elif task.op == "write"
                try
                    write_file(task.path, task.data)
                    task.success = 1
                    task.bytes_processed = len(task.data)
                    task.result_error = null
                catch err
                    task.success = 0
                    task.result_error = str(err)
                    task.bytes_processed = 0
                end
            end
            channel_send(res_ch, task)
        end
    end
    return 0
end

# Represents the worker thread pool managing asynchronous background I/O
pub struct FsThreadPool
    req_ch,
    res_ch,
    threads,
    tag,
    worker_count,
    active,
    pending_tasks,
    next_task_id
end

## Creates a new initialized FsThreadPool with the specified number of worker threads
pub function fs_pool_new(worker_count: int = 2)
    if worker_count is null or worker_count < 1
        worker_count = 2
    end
    let req_ch = channel_new()
    let res_ch = channel_new()
    let threads = []
    let i = 0
    while i < worker_count
        let t = thread_spawn(fs_worker_proc, (req_ch, res_ch))
        push(threads, t)
        i += 1
    end
    return FsThreadPool {
        req_ch: req_ch,
        res_ch: res_ch,
        threads: threads,
        tag: "fs_pool",
        worker_count: worker_count,
        active: 1,
        pending_tasks: 0,
        next_task_id: 1
    }
end

## Ensures the event loop has an initialized thread pool instance
pub function loop_ensure_fs_pool(loop)
    if loop is null
        return null
    end
    if loop.fs_pool is null
        loop.fs_pool = fs_pool_new(2)
    end
    return loop.fs_pool
end

# Dispatches an asynchronous file read operation to the worker thread pool
## Invokes `on_complete(err, content)` on the reactor loop when done
pub function fs_read_async(loop, path: string, on_complete)
    if loop is null
        return -1
    end
    let pool = loop_ensure_fs_pool(loop)
    if pool is null or pool.active == 0
        return -1
    end
    let tid = pool.next_task_id
    pool.next_task_id += 1
    let task = fs_task_new(tid, "read", path, null, on_complete)
    pool.pending_tasks += 1
    channel_send(pool.req_ch, task)
    return tid
end

# Dispatches an asynchronous file write operation to the worker thread pool
## Invokes `on_complete(err, bytes_written)` on the reactor loop when done
pub function fs_write_async(loop, path: string, data, on_complete = null)
    if loop is null
        return -1
    end
    let pool = loop_ensure_fs_pool(loop)
    if pool is null or pool.active == 0
        return -1
    end
    let tid = pool.next_task_id
    pool.next_task_id += 1
    let task = fs_task_new(tid, "write", path, data, on_complete)
    pool.pending_tasks += 1
    channel_send(pool.req_ch, task)
    return tid
end

# Polls completed filesystem tasks from the background worker response channel
## Returns an array of EventNotification records ready for dispatch
pub function fs_pool_poll_completed(loop)
    if loop is null or loop.fs_pool is null
        return []
    end
    let pool = loop.fs_pool
    let completed = []
    let has_more = 1
    while has_more == 1
        let task = channel_try_recv(pool.res_ch)
        if task is not null
            if pool.pending_tasks > 0
                pool.pending_tasks -= 1
            end
            let ev = event_notification_new(EventType.None, -1, task.id, "fs_async", task)
            push(completed, ev)
        else
            has_more = 0
        end
    end
    return completed
end

## Returns the number of currently active / pending filesystem tasks in the pool
pub function fs_pool_pending_count(loop) -> int
    if loop is null or loop.fs_pool is null
        return 0
    end
    return loop.fs_pool.pending_tasks
end

## Stops all background worker threads and frees channels
pub function fs_pool_free(pool)
    if pool is null or pool.active == 0
        return
    end
    pool.active = 0
    let i = 0
    while i < pool.worker_count
        let stop_task = fs_task_new(0, "stop", "", null, null)
        channel_send(pool.req_ch, stop_task)
        i += 1
    end
    for t in pool.threads
        thread_join(t)
    end
    channel_free(pool.req_ch)
    channel_free(pool.res_ch)
end
