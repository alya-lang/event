## # event/stream/reader
##
## Buffered stream reader and framing abstraction.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/str"
import "../types.alya"
import "./ring.alya"

## Constructs a new StreamReader instance.
pub function stream_reader_new(delimiter = "\n", max_frame_size = 1048576, capacity = 65536)
    if delimiter is null or len(delimiter) == 0
        delimiter = "\n"
    end
    if max_frame_size is null or max_frame_size <= 0
        max_frame_size = 1048576
    end
    return StreamReader {
        ring: ring_buffer_new(capacity),
        delimiter: delimiter,
        max_frame_size: max_frame_size
    }
end

# Appends an incoming raw network chunk into the reader buffer
pub function StreamReader.feed(self, chunk)
    if self is null or chunk is null or len(chunk) == 0
        return 0
    end
    return ring_write(self.ring, chunk)
end

# Extracts the next line terminated by \n (with optional \r stripped)
# Returns [line, has_line (1 or 0)]
pub function StreamReader.read_line(self)
    if self is null or ring_available(self.ring) == 0
        return ["", 0]
    end
    let idx = index_of(self.ring.raw, "\n")
    if idx < 0
        return ["", 0]
    end
    let raw = ring_read(self.ring, idx + 1)
    let line = raw[0..idx]
    if len(line) > 0 and line[(len(line) - 1)..len(line)] == "\r"
        line = line[0..(len(line) - 1)]
    end
    return [line, 1]
end

# Extracts a framed message payload up to delimiter `delim`
# Consumes the delimiter and returns [payload, has_message (1 or 0)]
pub function StreamReader.read_until(self, delim)
    if self is null or ring_available(self.ring) == 0 or delim is null or len(delim) == 0
        return ["", 0]
    end
    let idx = index_of(self.ring.raw, delim)
    if idx < 0
        return ["", 0]
    end
    let payload = self.ring.raw[0..idx]
    ring_read(self.ring, idx + len(delim))
    return [payload, 1]
end

# Extracts a fixed-length payload of exactly n bytes
# Returns [chunk, has_chunk (1 or 0)]
pub function StreamReader.read_bytes(self, n)
    if self is null or n is null or n <= 0 or ring_available(self.ring) < n
        return ["", 0]
    end
    let payload = ring_read(self.ring, n)
    return [payload, 1]
end

# Peeks up to n bytes from the reader without consuming them
pub function StreamReader.peek(self, n)
    if self is null
        return ""
    end
    return ring_peek(self.ring, n)
end

# Returns total bytes currently buffered in the reader
pub function StreamReader.available(self)
    if self is null
        return 0
    end
    return ring_available(self.ring)
end

# Clears all buffered data from the reader
pub function StreamReader.clear(self)
    if self is not null
        ring_clear(self.ring)
    end
end

# Returns 1 if reader has no buffered data, 0 otherwise
pub function StreamReader.is_empty(self)
    if self is null
        return 1
    end
    return ring_is_empty(self.ring)
end

# --- Functional API for StreamReader ---

pub function stream_reader_feed(reader, chunk)
    return StreamReader.feed(reader, chunk)
end

pub function stream_reader_read_line(reader)
    return StreamReader.read_line(reader)
end

pub function stream_reader_read_until(reader, delim)
    return StreamReader.read_until(reader, delim)
end

pub function stream_reader_read_bytes(reader, n)
    return StreamReader.read_bytes(reader, n)
end

pub function stream_reader_peek(reader, n)
    return StreamReader.peek(reader, n)
end

pub function stream_reader_available(reader)
    return StreamReader.available(reader)
end

pub function stream_reader_clear(reader)
    StreamReader.clear(reader)
end

pub function stream_reader_is_empty(reader)
    return StreamReader.is_empty(reader)
end
