# Non-Blocking Stream Byte Buffer
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"

# Appends incoming data chunk into the byte buffer
pub function buffer_append(buf, chunk)
    if buf is null or chunk is null or len(chunk) == 0
        return 0
    end
    push(buf.chunks, chunk)
    buf.total_bytes += len(chunk)
    return len(chunk)
end

# Concatenates and returns the entire contents of the buffer as a single string
pub function buffer_to_string(buf)
    if buf is null or len(buf.chunks) == 0
        return ""
    end
    let res = ""
    for chunk in buf.chunks
        res += chunk
    end
    return res
end

# Clears the buffer contents and resets total byte count
pub function buffer_clear(buf)
    if buf is not null
        buf.chunks = []
        buf.total_bytes = 0
    end
end

# Returns total byte length accumulated in the buffer
pub function buffer_len(buf)
    if buf is null
        return 0
    end
    return buf.total_bytes
end

# Extracts a line terminated by newline (\n or \r\n) from the buffer
# Returns [line, has_line (1 or 0)]
pub function buffer_read_line(buf)
    if buf is null or buf.total_bytes == 0
        return ["", 0]
    end
    let full = buffer_to_string(buf)
    let idx = index_of(full, "\n")
    if idx < 0
        return ["", 0]
    end

    let line = full[0..idx]
    # Strip trailing \r if CRLF
    if len(line) > 0 and line[(len(line) - 1)..len(line)] == "\r"
        line = line[0..(len(line) - 1)]
    end

    # Keep remainder in the buffer
    let remainder = full[(idx + 1)..len(full)]
    buf.chunks = []
    buf.total_bytes = 0
    if len(remainder) > 0
        buffer_append(buf, remainder)
    end

    return [line, 1]
end

# --- Struct Methods on StreamBuffer ---

pub function StreamBuffer.append(self: StreamBuffer, chunk)
    return buffer_append(self, chunk)
end

pub function StreamBuffer.to_string(self: StreamBuffer)
    return buffer_to_string(self)
end

pub function StreamBuffer.clear(self: StreamBuffer)
    buffer_clear(self)
end

pub function StreamBuffer.len(self: StreamBuffer)
    return buffer_len(self)
end

pub function StreamBuffer.read_line(self: StreamBuffer)
    return buffer_read_line(self)
end
