# Cross-Platform Socket Poller
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net"
import "../types.alya"

# Polls all registered active watchers for readiness within the allocated timeout
# Returns an array of EventNotification structs
function poller_poll_watchers(loop, wait_ms = 0)
    if loop == null
        return []
    end
    let events = []
    let w_count = len(loop.watchers)
    if w_count == 0
        if wait_ms > 0
            sleep(wait_ms)
        end
        return events
    end

    # Fast path: single watcher can use the full wait duration directly
    if w_count == 1
        let w = loop.watchers[0]
        if w.active == 1
            let res = tcp_poll(w.fd, wait_ms)
            if res == 1
                push(events, event_notification_new(1, w.fd, -1, w.tag, w.data))
            elif res == -1
                push(events, event_notification_new(4, w.fd, -1, w.tag, w.data))
            end
        end
        return events
    end

    # Multi-watcher path:
    # 1. Non-blocking probe first (timeout = 0)
    let i = 0
    while i < w_count
        let w = loop.watchers[i]
        if w.active == 1
            let res = tcp_poll(w.fd, 0)
            if res == 1
                push(events, event_notification_new(1, w.fd, -1, w.tag, w.data))
            elif res == -1
                push(events, event_notification_new(4, w.fd, -1, w.tag, w.data))
            end
        end
        i += 1
    end

    # If events were found or zero wait was requested, return immediately
    if len(events) > 0 or wait_ms <= 0
        return events
    end

    # 2. If nothing ready, poll in small discrete slices until timeout expires
    let start = clock_ms()
    while (clock_ms() - start) < wait_ms
        sleep(2)
        let j = 0
        while j < w_count
            let w = loop.watchers[j]
            if w.active == 1
                let res = tcp_poll(w.fd, 0)
                if res == 1
                    push(events, event_notification_new(1, w.fd, -1, w.tag, w.data))
                elif res == -1
                    push(events, event_notification_new(4, w.fd, -1, w.tag, w.data))
                end
            end
            j += 1
        end
        if len(events) > 0
            break
        end
    end

    return events
end
