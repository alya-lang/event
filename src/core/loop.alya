# Core EventLoop Engine
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "uv" as uv
import "../types.alya"
import "./timer.alya"
import "./watcher.alya"
import "./poller.alya"
import "../stream/stream.alya"
import "../net/server.alya"
import "../fs/async.alya"

# Creates a new initialized EventLoop instance
# Backed by high-performance OS kernel multiplexer (Lib/uv) with fallback to std/net
pub function event_loop_new(use_uv = true)
    let p = null
    let b = "fallback"
    if use_uv != false and use_uv != 0 and use_uv is not null
        p = uv::poller(64, 64)
        if p is not null
            b = uv::backend_name()
        end
    end
    return EventLoop {
        running: 0,
        timers: [],
        watchers: [],
        next_timer_id: 1,
        next_watcher_id: 1,
        tick_count: 0,
        stop_requested: 0,
        poller: p,
        backend: b,
        fs_pool: null
    }
end

# Requests the event loop to stop
pub function loop_stop(loop)
    if loop is not null
        loop.stop_requested = 1
        loop.running = 0
    end
end

# Returns the active backend name ("WSAPoll", "epoll", "kqueue", or "fallback")
pub function loop_backend(loop)
    if loop is null
        return "none"
    end
    return loop.backend
end

# Returns 1 if the event loop is active and has work to do, 0 otherwise
pub function loop_is_running(loop)
    if loop is null or loop.stop_requested == 1
        return 0
    end
    let timers = timer_count_active(loop)
    let watchers = watcher_count_active(loop)
    let fs_pending = fs_pool_pending_count(loop)
    if (timers + watchers + fs_pending) > 0
        return 1
    end
    return 0
end

# Returns the total count of active handles (timers + I/O watchers + async fs tasks)
pub function loop_active_count(loop)
    if loop is null
        return 0
    end
    let t = timer_count_active(loop)
    let w = watcher_count_active(loop)
    let f = fs_pool_pending_count(loop)
    return t + w + f
end

# Resets all state in the loop
pub function loop_reset(loop)
    if loop is not null
        if loop.poller is not null
            loop.poller.close()
            loop.poller = uv::poller(64, 64)
        end
        if loop.fs_pool is not null
            fs_pool_free(loop.fs_pool)
            loop.fs_pool = null
        end
        loop.timers = []
        loop.watchers = []
        loop.stop_requested = 0
        loop.running = 0
        loop.tick_count = 0
    end
end

# Executes a single tick through the event loop phases:
# 1. Calculate dynamic timeout based on closest timer
# 2. Poll socket I/O watchers via kernel multiplexer (or fallback)
# 3. Collect expired timers
# 4. Poll completed offloaded filesystem tasks from worker thread pool
# Returns an array of EventNotification records triggered in this tick
pub function loop_tick(loop, max_wait_ms = 100)
    if loop is null
        return []
    end
    if max_wait_ms is null or max_wait_ms < 0
        max_wait_ms = 0
    end

    loop.running = 1
    loop.tick_count += 1

    # 1. Dynamic sleep limit: do not sleep longer than the next pending timer
    let wait_ms = timer_nearest_wait_ms(loop, max_wait_ms)
    let fs_pending = fs_pool_pending_count(loop)
    if fs_pending > 0 and wait_ms > 10
        wait_ms = 10
    end

    # 2. I/O Polling Phase
    let io_events = poller_poll_watchers(loop, wait_ms)

    # 3. Timers Phase
    let timer_events = timer_collect_expired(loop)

    # 4. Async Filesystem Phase
    let fs_events = fs_pool_poll_completed(loop)

    # 5. Merge notifications
    let all_events = []
    for ev in io_events
        push(all_events, ev)
    end
    for ev in timer_events
        push(all_events, ev)
    end
    for ev in fs_events
        push(all_events, ev)
    end

    return all_events
end

# Polls the event loop for up to max_wait_ms milliseconds and returns all triggered events
pub function loop_poll(loop, max_wait_ms = 100)
    return loop_tick(loop, max_wait_ms)
end

# Dispatches an event notification to its registered handler or callbacks
pub function loop_dispatch_event(ev)
    if ev is null or ev.data is null
        return 0
    end
    let tag = ev.tag
    if tag == "tcp_server"
        let srv = ev.data
        tcp_server_accept(srv)
        return 1
    end
    if tag == "tcp_stream_read"
        let stream = ev.data
        if ev.event_type == EventType.Read
            tcp_stream_read(stream)
        elif ev.event_type == EventType.Error
            tcp_stream_close(stream)
        end
        return 1
    end
    if tag == "tcp_stream_write"
        let stream = ev.data
        if ev.event_type == EventType.Write
            tcp_stream_flush(stream)
        elif ev.event_type == EventType.Error
            tcp_stream_close(stream)
        end
        return 1
    end
    if tag == "tcp_stream_rw"
        let stream = ev.data
        if ev.event_type == EventType.Read
            tcp_stream_read(stream)
        elif ev.event_type == EventType.Write
            tcp_stream_flush(stream)
        elif ev.event_type == EventType.Error
            tcp_stream_close(stream)
        end
        return 1
    end
    if tag == "readable"
        let cb = ev.data
        cb(ev.fd)
        return 1
    end
    if tag == "writable"
        let cb = ev.data
        cb(ev.fd)
        return 1
    end
    if tag == "fs_async"
        let task = ev.data
        let cb = task.on_complete
        if cb is not null
            if task.op == "read"
                cb(task.result_error, task.result_data)
            elif task.op == "write"
                cb(task.result_error, task.bytes_processed)
            end
        end
        return 1
    end
    if tag == "callback" or tag == "timeout" or tag == "interval"
        let cb = ev.data
        cb(ev)
        return 1
    end
    return 0
end

# Continuously runs the event loop until stop is requested or no active handles remain.
# If on_event callback is provided, it is invoked for each triggered event.
# Otherwise, events are dispatched automatically to registered handlers.
# Returns total number of events processed across all iterations.
pub function loop_run(loop, max_wait_ms = 100, on_event = null)
    if loop is null
        return 0
    end
    let total_events = 0
    while loop_is_running(loop) == 1
        let events = loop_tick(loop, max_wait_ms)
        if len(events) > 0
            total_events += len(events)
            for ev in events
                if on_event is not null
                    on_event(ev)
                else
                    loop_dispatch_event(ev)
                end
            end
        end
    end
    return total_events
end

# Registers an OS process signal watcher (e.g. SIGINT = 2, SIGTERM = 15)
pub function loop_watch_signal(loop, signum, tag = "signal", data = null)
    if loop is null or loop.poller is null or signum is null or signum <= 0
        return -1
    end
    let wid = loop.next_watcher_id
    loop.next_watcher_id += 1
    let res = loop.poller.watch_signal(signum, wid)
    if res == 0
        let w = io_watcher_new(wid, signum, 16, tag, data)
        push(loop.watchers, w)
        return wid
    end
    return -1
end

# Deregisters an OS process signal watcher
pub function loop_unwatch_signal(loop, signum)
    if loop is null or loop.poller is null or signum is null or signum <= 0
        return 0
    end
    let removed = watcher_remove(loop, signum)
    loop.poller.unwatch_signal(signum)
    return removed
end

# Frees and resets all resources in the event loop
pub function loop_free(loop)
    if loop is not null
        loop_stop(loop)
        if loop.poller is not null
            loop.poller.close()
            loop.poller = null
        end
        if loop.fs_pool is not null
            fs_pool_free(loop.fs_pool)
            loop.fs_pool = null
        end
        loop.timers = []
        loop.watchers = []
        loop.stop_requested = 0
        loop.running = 0
        loop.tick_count = 0
    end
end

# UFCS global dispatch for loop.run(...)
pub function run(loop, max_wait_ms = 100, on_event = null)
    return loop_run(loop, max_wait_ms, on_event)
end

# UFCS global dispatch for loop.free(...)
pub function free(loop)
    loop_free(loop)
end

# --- Struct Methods on EventLoop ---

pub function EventLoop.stop(self)
    loop_stop(self)
end

pub function EventLoop.backend(self)
    return loop_backend(self)
end

pub function EventLoop.is_running(self)
    return loop_is_running(self)
end

pub function EventLoop.active_count(self)
    return loop_active_count(self)
end

pub function EventLoop.reset(self)
    loop_reset(self)
end

pub function EventLoop.free(self)
    loop_free(self)
end

pub function EventLoop.tick(self, max_wait_ms = 100)
    return loop_tick(self, max_wait_ms)
end

pub function EventLoop.poll(self, max_wait_ms = 100)
    return loop_poll(self, max_wait_ms)
end

pub function EventLoop.run(self, max_wait_ms = 100, on_event = null)
    return loop_run(self, max_wait_ms, on_event)
end

pub function EventLoop.timeout(self, delay_ms, tag = "", data = null)
    return timer_add_timeout(self, delay_ms, tag, data)
end

pub function EventLoop.set_timeout(self, delay_ms, tag = "", data = null)
    return timer_add_timeout(self, delay_ms, tag, data)
end

pub function EventLoop.interval(self, interval_ms, tag = "", data = null)
    return timer_add_interval(self, interval_ms, tag, data)
end

pub function EventLoop.set_interval(self, interval_ms, tag = "", data = null)
    return timer_add_interval(self, interval_ms, tag, data)
end

pub function EventLoop.clear_timer(self, timer_id)
    return timer_cancel(self, timer_id)
end

pub function EventLoop.watch_read(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 1, tag, data)
end

pub function EventLoop.watch_readable(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 1, tag, data)
end

pub function EventLoop.watch_write(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 2, tag, data)
end

pub function EventLoop.watch_writable(self, fd, tag = "", data = null)
    return watcher_add(self, fd, 2, tag, data)
end

pub function EventLoop.watch_signal(self, signum, tag = "signal", data = null)
    return loop_watch_signal(self, signum, tag, data)
end

pub function EventLoop.unwatch_signal(self, signum)
    return loop_unwatch_signal(self, signum)
end

pub function EventLoop.unwatch(self, fd)
    return watcher_remove(self, fd)
end

pub function EventLoop.on_readable(self, fd, callback)
    return watcher_add(self, fd, 1, "readable", callback)
end

pub function EventLoop.on_writable(self, fd, callback)
    return watcher_add(self, fd, 2, "writable", callback)
end

pub function EventLoop.dispatch(self, ev)
    return loop_dispatch_event(ev)
end

pub function EventLoop.fs_read(self, path, on_complete)
    return fs_read_async(self, path, on_complete)
end

pub function EventLoop.fs_write(self, path, data, on_complete = null)
    return fs_write_async(self, path, data, on_complete)
end

pub function EventLoop.read_file(self, path, on_complete)
    return fs_read_async(self, path, on_complete)
end

pub function EventLoop.write_file(self, path, data, on_complete = null)
    return fs_write_async(self, path, data, on_complete)
end
