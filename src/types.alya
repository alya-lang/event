# Event-driven I/O Types and Structures for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enumeration for reactor event categories (exported via pub)
pub enum EventType
    None,
    Read,
    Write,
    Timer,
    Error,
    Close,
    Signal
end

# Returns human-readable name of an event type using pattern matching
pub function event_type_name(t)
    return when t
        is EventType.Read   => "READ"
        is EventType.Write  => "WRITE"
        is EventType.Timer  => "TIMER"
        is EventType.Error  => "ERROR"
        is EventType.Close  => "CLOSE"
        is EventType.Signal => "SIGNAL"
        else                => "UNKNOWN"
    end
end

# --- Notification Record ---
# Represents a single dispatched event generated by the reactor loop
pub struct EventNotification
    event_type,
    fd,
    timer_id,
    tag,
    data,
    timestamp
end

# Struct method: summary string representation
pub function EventNotification.summary(self)
    let type_str = event_type_name(self.event_type)
    return "EventNotification({type_str}, fd={self.fd}, timer_id={self.timer_id}, tag={self.tag})"
end

# Constructs an EventNotification struct
pub function event_notification_new(event_type, fd = -1, timer_id = -1, tag = "", data = null)
    return EventNotification {
        event_type: event_type,
        fd: fd,
        timer_id: timer_id,
        tag: tag,
        data: data,
        timestamp: clock_ms()
    }
end

# --- Timer Definition ---
pub struct Timer
    id,
    deadline_ms,
    interval_ms,
    tag,
    data,
    active
end

# Struct methods for Timer
pub function Timer.is_active(self)
    return self.active == 1
end

pub function Timer.cancel(self)
    self.active = 0
end

# Constructs a Timer record
pub function timer_new(id, deadline_ms, interval_ms = 0, tag = "", data = null)
    return Timer {
        id: id,
        deadline_ms: deadline_ms,
        interval_ms: interval_ms,
        tag: tag,
        data: data,
        active: 1
    }
end

# --- Socket I/O Watcher Definition ---
pub struct IoWatcher
    id,
    fd,
    events,
    tag,
    data,
    active
end

# Struct methods for IoWatcher
pub function IoWatcher.is_active(self)
    return self.active == 1
end

pub function IoWatcher.cancel(self)
    self.active = 0
end

# Constructs an IoWatcher record
pub function io_watcher_new(id, fd, events = 1, tag = "", data = null)
    return IoWatcher {
        id: id,
        fd: fd,
        events: events,
        tag: tag,
        data: data,
        active: 1
    }
end

# --- Core Event Loop Definition ---
pub struct EventLoop
    running,
    timers,
    watchers,
    next_timer_id,
    next_watcher_id,
    tick_count,
    stop_requested,
    poller,
    backend
end

# --- Stream Byte Buffer ---
pub struct ByteBuffer
    chunks,
    total_bytes
end

# Constructs a ByteBuffer instance
pub function byte_buffer_new()
    return ByteBuffer {
        chunks: [],
        total_bytes: 0
    }
end

# --- Event Emitter Listener Definition ---
pub struct EventListener
    id,
    event_name,
    is_once,
    tag,
    data,
    active
end

# --- Event Emitter Definition ---
pub struct EventEmitter
    listeners,
    next_id
end

# Constructs an EventEmitter instance
pub function event_emitter_new()
    return EventEmitter {
        listeners: {},
        next_id: 1
    }
end

# --- Circular Ring Buffer Definition ---
pub struct RingBuffer
    raw,
    size,
    capacity
end

# --- Buffered Stream Reader Definition ---
pub struct StreamReader
    ring,
    delimiter,
    max_frame_size
end

# --- High-Level TCP Stream Definition ---
pub struct TcpStream
    loop,
    fd,
    peer_addr,
    tag,
    data,
    closed,
    paused,
    high_water_mark,
    write_buf,
    reader,
    peer_ip,
    peer_port,
    on_data_cb,
    on_line_cb,
    on_close_cb,
    on_error_cb,
    on_drain_cb
end

# --- High-Level TCP Server Definition ---
pub struct TcpServer
    loop,
    fd,
    host,
    tag,
    data,
    port,
    backlog,
    listening,
    on_connect_cb,
    on_error_cb,
    clients
end
