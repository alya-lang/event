## # event/types
##
## Core types, structures, and enumerations for the event package.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines reactor event types, I/O watcher records, timer descriptors,
## stream buffers, socket abstractions, and event emitters.

## Categorical enumeration for reactor event loop notifications.
pub enum EventType
    None = 0,
    Read = 1,
    Write = 2,
    Timer = 3,
    Error = 4,
    Close = 5,
    Signal = 6
end

## I/O readiness event filter mask for socket watching.
pub enum WatchEvent
    Readable = 1,
    Writable = 2,
    Both = 3
end

## Supported OS kernel multiplexer backends.
pub enum LoopBackend
    Auto = 0,
    WsaPoll = 1,
    Epoll = 2,
    Kqueue = 3,
    Fallback = 4
end

## Returns the human-readable string representation of an EventType.
##
## ### Parameters
## - `t`: `EventType` variant.
##
## ### Returns
## Uppercase event name string.
pub function event_type_name(t) -> string
    return when t
        is EventType.Read   => "READ"
        is EventType.Write  => "WRITE"
        is EventType.Timer  => "TIMER"
        is EventType.Error  => "ERROR"
        is EventType.Close  => "CLOSE"
        is EventType.Signal => "SIGNAL"
        else                => "UNKNOWN"
    end
end

## Dispatched event notification record generated by the event loop.
##
## ### Fields
## - `event_type`: `EventType` variant indicating notification kind.
## - `fd`: Associated file descriptor or socket handle (`-1` if timer/signal).
## - `timer_id`: Timer identifier (`-1` if socket/signal).
## - `tag`: User-defined string tag for routing and dispatching.
## - `data`: Arbitrary user payload attached to the watcher or timer.
## - `timestamp`: Millisecond monotonic timestamp when event triggered.
pub struct EventNotification
    event_type: int,
    fd: int,
    timer_id: int,
    tag: string,
    data,
    timestamp: int
end

## Returns a summary string representation of an EventNotification.
pub function EventNotification.summary(self: EventNotification) -> string
    let type_str = event_type_name(self.event_type)
    return "EventNotification({type_str}, fd={self.fd}, timer_id={self.timer_id}, tag={self.tag})"
end

## Constructs a new EventNotification struct instance.
##
## ### Parameters
## - `event_type`: Notification event category.
## - `fd`: Socket handle (default `-1`).
## - `timer_id`: Timer handle (default `-1`).
## - `tag`: String routing tag (default `""`).
## - `data`: Optional attached payload.
##
## ### Returns
## Initialized `EventNotification` instance.
pub function event_notification_new(event_type, fd: int = -1, timer_id: int = -1, tag: string = "", data = null)
    return EventNotification {
        event_type: event_type,
        fd: fd,
        timer_id: timer_id,
        tag: tag,
        data: data,
        timestamp: clock_ms()
    }
end

## Monotonic timer record tracked by the reactor event loop.
##
## ### Fields
## - `id`: Unique timer identifier integer.
## - `deadline_ms`: Absolute millisecond timestamp when timer will trigger.
## - `interval_ms`: Periodic repeat interval in milliseconds (`0` for one-shot timeout).
## - `tag`: User-defined routing tag.
## - `data`: Arbitrary user payload.
## - `active`: `1` if timer is active, `0` if cancelled.
pub struct Timer
    id: int,
    deadline_ms: int,
    interval_ms: int,
    tag: string,
    data,
    active: int
end

## Returns whether this timer is currently active.
pub function Timer.is_active(self: Timer) -> int
    return self.active == 1
end

## Cancels this timer, preventing it from firing further.
pub function Timer.cancel(self: Timer)
    self.active = 0
end

## Constructs a new Timer record instance.
##
## ### Parameters
## - `id`: Unique integer timer id.
## - `deadline_ms`: Absolute trigger timestamp in milliseconds.
## - `interval_ms`: Milliseconds repeat period (`0` for one-shot).
## - `tag`: Tag string.
## - `data`: Optional attached data payload.
##
## ### Returns
## Initialized `Timer` instance.
pub function timer_new(id, deadline_ms, interval_ms: int = 0, tag: string = "", data = null)
    return Timer {
        id: id,
        deadline_ms: deadline_ms,
        interval_ms: interval_ms,
        tag: tag,
        data: data,
        active: 1
    }
end

## Socket I/O interest watcher registered with the kernel multiplexer.
##
## ### Fields
## - `id`: Unique watcher identifier integer.
## - `fd`: Monitored socket descriptor.
## - `events`: Bitmask of interest events (`1` = READ, `2` = WRITE, `3` = BOTH).
## - `tag`: User routing tag.
## - `data`: Attached user payload.
## - `active`: `1` if watcher is active, `0` if cancelled.
pub struct IoWatcher
    id: int,
    fd: int,
    events: int,
    tag: string,
    data,
    active: int
end

## Returns whether this I/O watcher is currently active.
pub function IoWatcher.is_active(self: IoWatcher) -> int
    return self.active == 1
end

## Cancels this I/O watcher and ceases polling its descriptor.
pub function IoWatcher.cancel(self: IoWatcher)
    self.active = 0
end

## Constructs a new IoWatcher record instance.
##
## ### Parameters
## - `id`: Unique watcher id.
## - `fd`: Monitored socket descriptor.
## - `events`: Event bitmask (default `1` for READ).
## - `tag`: Routing tag string.
## - `data`: Optional attached data payload.
##
## ### Returns
## Initialized `IoWatcher` instance.
pub function io_watcher_new(id, fd: int, events: int = 1, tag: string = "", data = null)
    return IoWatcher {
        id: id,
        fd: fd,
        events: events,
        tag: tag,
        data: data,
        active: 1
    }
end

## Core single-threaded cooperative event loop instance.
##
## ### Fields
## - `running`: `1` if loop is running tick cycle, `0` if stopped.
## - `timers`: Array of registered `Timer` instances.
## - `watchers`: Array of registered `IoWatcher` instances.
## - `next_timer_id`: Auto-incrementing timer id counter.
## - `next_watcher_id`: Auto-incrementing watcher id counter.
## - `tick_count`: Cumulative iteration count.
## - `stop_requested`: Flag requesting graceful loop exit.
## - `poller`: OS kernel multiplexer handle.
## - `backend`: Name string of active backend engine.
## - `fs_pool`: Optional asynchronous worker thread pool.
pub struct EventLoop
    running: int,
    timers: array,
    watchers: array,
    next_timer_id: int,
    next_watcher_id: int,
    tick_count: int,
    stop_requested: int,
    poller,
    backend: string,
    fs_pool
end

## Dynamic byte buffer holding chunked string sequences.
pub struct StreamBuffer
    chunks: array,
    total_bytes: int
end

## Constructs an empty StreamBuffer instance.
##
## ### Returns
## Initialized `StreamBuffer` instance.
pub function byte_buffer_new()
    return StreamBuffer {
        chunks: [],
        total_bytes: 0
    }
end

## Registered event listener callback definition.
pub struct EventListener
    id: int,
    event_name: string,
    is_once: int,
    tag: string,
    data,
    active: int
end

## Event emitter registry managing event subscriptions and dispatch.
pub struct EventEmitter
    listeners: map,
    next_id: int
end

## Constructs a new EventEmitter instance.
##
## ### Returns
## Initialized `EventEmitter` instance.
pub function event_emitter_new()
    return EventEmitter {
        listeners: {},
        next_id: 1
    }
end

## High-performance circular ring buffer for stream data.
pub struct RingBuffer
    raw,
    size: int,
    capacity: int
end

## Frame-delimited buffered stream reader for continuous streams.
pub struct StreamReader
    ring,
    delimiter: string,
    max_frame_size: int
end

## High-level asynchronous non-blocking TCP socket stream.
pub struct TcpStream
    loop,
    fd: int,
    peer_addr: string,
    tag: string,
    data,
    closed: int,
    paused: int,
    high_water_mark: int,
    write_buf: array,
    reader,
    peer_ip: string,
    peer_port: int,
    on_data_cb,
    on_line_cb,
    on_close_cb,
    on_error_cb,
    on_drain_cb
end

## High-level asynchronous non-blocking TCP server listener.
pub struct TcpServer
    loop,
    fd: int,
    host: string,
    tag: string,
    data,
    port: int,
    backlog: int,
    listening: int,
    on_connect_cb,
    on_error_cb,
    clients: array
end
