# Event-driven I/O Types and Structures for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# --- Event Type Constants ---
function event_type_none()
    return 0
end

function event_type_read()
    return 1
end

function event_type_write()
    return 2
end

function event_type_timer()
    return 3
end

function event_type_error()
    return 4
end

function event_type_close()
    return 5
end

# Returns human-readable name of an event type
function event_type_name(t)
    if t == 1
        return "READ"
    elif t == 2
        return "WRITE"
    elif t == 3
        return "TIMER"
    elif t == 4
        return "ERROR"
    elif t == 5
        return "CLOSE"
    end
    return "UNKNOWN"
end

# --- Notification Record ---
# Represents a single dispatched event generated by the reactor loop
struct EventNotification
    event_type
    fd
    timer_id
    tag
    data
    timestamp
end

# Constructs an EventNotification struct
function event_notification_new(event_type, fd = -1, timer_id = -1, tag = "", data = null)
    return EventNotification {
        event_type: event_type,
        fd: fd,
        timer_id: timer_id,
        tag: tag,
        data: data,
        timestamp: clock_ms()
    }
end

# --- Timer Definition ---
struct Timer
    id
    deadline_ms
    interval_ms
    tag
    data
    active
end

# Constructs a Timer record
function timer_new(id, deadline_ms, interval_ms = 0, tag = "", data = null)
    return Timer {
        id: id,
        deadline_ms: deadline_ms,
        interval_ms: interval_ms,
        tag: tag,
        data: data,
        active: 1
    }
end

# --- Socket I/O Watcher Definition ---
struct IoWatcher
    id
    fd
    events
    tag
    data
    active
end

# Constructs an IoWatcher record
function io_watcher_new(id, fd, events = 1, tag = "", data = null)
    return IoWatcher {
        id: id,
        fd: fd,
        events: events,
        tag: tag,
        data: data,
        active: 1
    }
end

# --- Core Event Loop Definition ---
struct EventLoop
    running
    timers
    watchers
    next_timer_id
    next_watcher_id
    tick_count
    stop_requested
end

# --- Stream Byte Buffer ---
struct ByteBuffer
    chunks
    total_bytes
end

function byte_buffer_new()
    return ByteBuffer {
        chunks: [],
        total_bytes: 0
    }
end

# --- Event Emitter Listener Definition ---
struct EventListener
    id
    event_name
    is_once
    tag
    data
    active
end

# --- Event Emitter Definition ---
struct EventEmitter
    listeners
    next_id
end

function event_emitter_new()
    return EventEmitter {
        listeners: {},
        next_id: 1
    }
end
