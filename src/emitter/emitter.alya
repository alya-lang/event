## # event/emitter
##
## Publish-Subscribe Event Emitter pattern implementation.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Allows registering persistent and one-time listeners with routing tags.

import "../types.alya"

## Creates a new EventEmitter instance.
pub function emitter_new()
    return event_emitter_new()
end

# Registers a persistent listener tag for an event
# Returns assigned listener ID
pub function emitter_on(em, event_name, tag)
    if em is null or event_name is null or len(event_name) == 0
        return -1
    end
    let lid = em.next_id
    em.next_id += 1
    let listener = EventListener {
        id: lid,
        event_name: event_name,
        is_once: 0,
        tag: tag,
        data: null,
        active: 1
    }

    if event_name not in em.listeners
        em.listeners[event_name] = []
    end
    push(em.listeners[event_name], listener)
    return lid
end

# Registers a one-time listener tag that automatically deregisters after being emitted once
pub function emitter_once(em, event_name, tag)
    if em is null or event_name is null or len(event_name) == 0
        return -1
    end
    let lid = em.next_id
    em.next_id += 1
    let listener = EventListener {
        id: lid,
        event_name: event_name,
        is_once: 1,
        tag: tag,
        data: null,
        active: 1
    }

    if event_name not in em.listeners
        em.listeners[event_name] = []
    end
    push(em.listeners[event_name], listener)
    return lid
end

# Removes a listener from an event by tag or ID
# Returns 1 if removed, 0 if not found
pub function emitter_off(em, event_name, tag)
    if em is null or event_name is null or event_name not in em.listeners
        return 0
    end
    let list = em.listeners[event_name]
    let removed = 0
    let remaining = []
    for l in list
        if l.tag == tag or str(l.id) == str(tag)
            l.active = 0
            removed = 1
        else
            if l.active == 1
                push(remaining, l)
            end
        end
    end
    em.listeners[event_name] = remaining
    return removed
end

# Returns the number of active listeners for a given event name
pub function emitter_listener_count(em, event_name)
    if em is null or event_name is null or event_name not in em.listeners
        return 0
    end
    let list = em.listeners[event_name]
    let active_count = 0
    for l in list
        if l.active == 1
            active_count += 1
        end
    end
    return active_count
end

## Emits an event with payload data to all registered listeners.
## Returns an array of triggered listener tags (and auto-removes any `once` listeners).
pub function emitter_emit(em, event_name, _data = null)
    if em is null or event_name is null or event_name not in em.listeners
        return []
    end
    let list = em.listeners[event_name]
    let triggered_tags = []
    let remaining = []
    for l in list
        if l.active == 1
            push(triggered_tags, l.tag)
            if l.is_once == 1
                l.active = 0
            else
                push(remaining, l)
            end
        end
    end
    em.listeners[event_name] = remaining
    return triggered_tags
end

# Clears all listeners for an event name, or all events if event_name is null
pub function emitter_clear(em, event_name = null)
    if em is null
        return 0
    end
    if event_name is null
        em.listeners = {}
        return 1
    end
    if event_name in em.listeners
        em.listeners[event_name] = []
        return 1
    end
    return 0
end

# --- Struct Methods on EventEmitter ---

pub function EventEmitter.on(self, event_name, tag)
    return emitter_on(self, event_name, tag)
end

pub function EventEmitter.once(self, event_name, tag)
    return emitter_once(self, event_name, tag)
end

pub function EventEmitter.off(self, event_name, tag)
    return emitter_off(self, event_name, tag)
end

pub function EventEmitter.listener_count(self, event_name)
    return emitter_listener_count(self, event_name)
end

pub function EventEmitter.emit(self, event_name, data = null)
    return emitter_emit(self, event_name, data)
end

pub function EventEmitter.clear(self, event_name = null)
    return emitter_clear(self, event_name)
end
