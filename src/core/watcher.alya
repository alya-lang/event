## # event/core/watcher
##
## Socket I/O watcher registry for EventLoop.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"

## Registers an I/O watcher for socket `fd`.
## `events`: 1 (READ), 2 (WRITE), or 3 (READ | WRITE).
pub function watcher_add(loop: EventLoop, fd: int, events: int = 1, tag: string = "", data = null)
    if loop is null or fd is null or fd < 0
        return -1
    end
    # Check if an existing watcher for this fd is already registered
    let watcher_count = len(loop.watchers)
    for i in 0..watcher_count
        let w: IoWatcher = loop.watchers[i]
        if w.fd == fd and w.active == true
            # Update existing watcher with new events / tag / data
            w.events = events
            w.tag = tag
            w.data = data
            @cfg(feature = "uv")
            if loop.poller is not null
                loop.poller.modify(fd, events, w.id)
            end
            return w.id
        end
    end

    let wid = loop.next_watcher_id
    loop.next_watcher_id += 1
    let w: IoWatcher = io_watcher_new(wid, fd, events, tag, data)
    push(loop.watchers, w)
    @cfg(feature = "uv")
    if loop.poller is not null
        loop.poller.add(fd, events, wid)
    end
    return wid
end

# Removes an I/O watcher for a socket descriptor
## Returns 1 if found and removed, 0 otherwise
pub function watcher_remove(loop: EventLoop, fd: int) -> int
    if loop is null or fd is null
        return false
    end
    let removed = false
    let active_remaining = []
    let watcher_count = len(loop.watchers)
    for i in 0..watcher_count
        let w: IoWatcher = loop.watchers[i]
        if w.fd == fd
            w.active = false
            removed = true
        else
            if w.active == true
                push(active_remaining, w)
            end
        end
    end
    loop.watchers = active_remaining
    @cfg(feature = "uv")
    if removed == true and loop.poller is not null
        loop.poller.remove(fd)
    end
    return removed
end

## Returns the number of currently active socket watchers
pub function watcher_count_active(loop: EventLoop) -> int
    if loop is null
        return 0
    end
    let active_count = 0
    let watcher_count = len(loop.watchers)
    for i in 0..watcher_count
        let w: IoWatcher = loop.watchers[i]
        if w.active == true
            active_count += 1
        end
    end
    return active_count
end

## Finds an active watcher by socket descriptor.
pub function watcher_find(loop: EventLoop, fd: int)
    if loop is null or fd is null
        return null
    end
    let watcher_count = len(loop.watchers)
    for i in 0..watcher_count
        let w: IoWatcher = loop.watchers[i]
        if w.fd == fd and w.active == true
            return w
        end
    end
    return null
end

## Finds an active watcher by unique watcher ID.
pub function watcher_find_by_id(loop: EventLoop, wid: int)
    if loop is null or wid is null
        return null
    end
    let watcher_count = len(loop.watchers)
    for i in 0..watcher_count
        let w: IoWatcher = loop.watchers[i]
        if w.id == wid and w.active == true
            return w
        end
    end
    return null
end
